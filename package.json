{
  "name": "letsvibe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @letsvibe/web dev",
    "build": "turbo run build",
    "typegen": "corepack pnpm --filter @letsvibe/web typegen",
    "typecheck": "corepack pnpm typegen && turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "setup": "corepack pnpm install && corepack pnpm typegen && corepack pnpm seed",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build",
    "db:generate": "corepack pnpm --filter @letsvibe/web db:generate",
    "db:migrate": "corepack pnpm --filter @letsvibe/web db:migrate",
    "seed": "corepack pnpm --filter @letsvibe/web seed",
    "ingest": "corepack pnpm --filter @letsvibe/web ingest",
    "retag": "corepack pnpm --filter @letsvibe/web retag",
    "passcodes": "corepack pnpm --filter @letsvibe/web passcodes",
    "go-live": "corepack pnpm --filter @letsvibe/web go-live"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
