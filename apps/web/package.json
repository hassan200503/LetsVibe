{
  "name": "@lovora/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "ingest": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ingest.ts",
    "test": "vitest run",
    "a11y": "node scripts/a11y-audit.mjs",
    "motion": "node scripts/motion-audit.mjs",
    "retag": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/retag.ts",
    "passwords": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/passwords.ts",
    "entitlements": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/entitlements.ts",
    "flags": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/flags.ts",
    "go-live": "node scripts/go-live.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@lovora/domain": "workspace:*",
    "@lovora/sync-protocol": "workspace:*",
    "@lovora/ui-tokens": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.104.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.2.12",
    "next": "16.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
